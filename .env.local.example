# ===========================================
# Divine Connections - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Anthropic (Claude API) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Resend (Transactional Email) ----
RESEND_API_KEY=re_...
EMAIL_FROM="Divine Connections <noreply@divineconnections.ca>"
ADMIN_NOTIFICATION_EMAIL=admin@divineconnections.ca

# ---- Upstash Redis (Rate Limiting) ----
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ---- Google reCAPTCHA v3 ----
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# ---- Google Drive (Admin Documents) ----
NEXT_PUBLIC_GDRIVE_FOLDER_ID=your-folder-id

# ---- App Config ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

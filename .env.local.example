# ===========================================
# Divine Connections - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Anthropic (Claude API) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Resend (Transactional Email) ----
RESEND_API_KEY=re_...
EMAIL_FROM="Divine Connections <noreply@divineconnections.ca>"
ADMIN_NOTIFICATION_EMAIL=admin@divineconnections.ca

# ---- Upstash Redis (Rate Limiting) ----
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ---- Google reCAPTCHA v3 ----
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# ---- Google Drive (Admin Documents) ----
NEXT_PUBLIC_GDRIVE_FOLDER_ID=your-folder-id

# ---- App Config ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Contemplating Death (January 16, 2027) ----
# Supabase project that stores this event's registrations (Mathabah project).
# The service role key is a secret: server only, never NEXT_PUBLIC.
CD_SUPABASE_URL=https://your-mathabah-project.supabase.co
CD_SUPABASE_SERVICE_ROLE_KEY=your-mathabah-service-role-key
# Public origin used in Stripe return URLs, ticket emails and QR codes.
# Defaults to NEXT_PUBLIC_APP_URL. Set this if the event gets its own domain.
CD_SITE_URL=
# Set to false to close the registration form.
CD_REGISTRATION_OPEN=true
# Optional seat cap. Leave empty for no cap.
CD_CAPACITY=
# Optional Stripe price ID (price_...). When empty, checkout charges $50.00 CAD.
CD_STRIPE_PRICE_ID=
# Optional. Signing secret for /api/contemplating-death/webhook.
# Defaults to STRIPE_WEBHOOK_SECRET.
CD_STRIPE_WEBHOOK_SECRET=
# Optional sender for ticket emails. Defaults to the EMAIL_FROM address
# under the name "Mathabah Learning Centre".
CD_EMAIL_FROM=
